#!/usr/bin/env bash
#
# Build IEC60730 unit tests and/or integration tests (compile only).
#
# Usage:
#   ./script/build [unit|integration|all] [BOARD_NAME] [extra cmake args...]
#
# Defaults: mode=all, BOARD_NAME=brd4264c
#

set -euo pipefail

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

MODE="${1:-all}"
shift || true
BOARD_NAME="${1:-brd4264c}"
if [[ $# -gt 0 ]]; then
    shift || true
fi
BUILD_ARGS=("$@")

UNIT_TARGETS=(
    unit_test_iec60730_post
    unit_test_iec60730_bist
    unit_test_iec60730_program_counter
    unit_test_iec60730_safety_check
    unit_test_iec60730_irq
    unit_test_iec60730_system_clock
    unit_test_iec60730_watchdog
    unit_test_iec60730_cpu_registers
    unit_test_iec60730_variable_memory
    unit_test_iec60730_invariable_memory
)

INTEGRATION_TARGETS=(
    integration_test_iec60730_program_counter
    integration_test_iec60730_irq
    integration_test_iec60730_system_clock
    integration_test_iec60730_watchdog
    integration_test_iec60730_cpu_registers
    integration_test_iec60730_variable_memory
    integration_test_iec60730_invariable_memory
)

ensure_env()
{
    # shellcheck source=set_env.sh
    source "${script_dir}/set_env.sh"

    if [ -z "${SDK_PATH:-}" ] || [ ! -d "${SDK_PATH}" ]; then
        echo "Error: SDK_PATH is not set or does not exist."
        exit 1
    fi
    if [ -z "${TOOL_DIRS:-}" ] || [ ! -d "${TOOL_DIRS}" ]; then
        echo "Error: TOOL_DIRS is not set or does not exist."
        exit 1
    fi
}

prepare_workspace()
{
    cd "${repo_dir}"
    make prepare
}

build_cmake_targets()
{
    local enable_flag="$1"
    shift
    local -a targets=("$@")

    prepare_workspace
    cd "${repo_dir}/build"

    # shellcheck disable=SC2086
    cmake --toolchain ../cmake/toolchain.cmake .. \
        "${enable_flag}" \
        -DBOARD_NAME="${BOARD_NAME}" \
        ${BUILD_ARGS[@]+"${BUILD_ARGS[@]}"}

    local target
    for target in "${targets[@]}"; do
        echo ">>> Building ${target}..."
        cmake --build . --target "${target}" -j"$(nproc 2>/dev/null || echo 4)"
    done
}

stash_unit_artifacts()
{
    local src="${repo_dir}/build/test/unit_test"
    local dst="${repo_dir}/.docker-build-stash/unit_test"
    if [ -d "${src}" ]; then
        rm -rf "${dst}"
        mkdir -p "$(dirname "${dst}")"
        cp -a "${src}" "${dst}"
    fi
}

restore_unit_artifacts()
{
    local src="${repo_dir}/.docker-build-stash/unit_test"
    local dst="${repo_dir}/build/test/unit_test"
    if [ -d "${src}" ]; then
        mkdir -p "$(dirname "${dst}")"
        rm -rf "${dst}"
        cp -a "${src}" "${dst}"
        rm -rf "${repo_dir}/.docker-build-stash"
    fi
}

build_unit()
{
    echo ">>> Building unit tests for ${BOARD_NAME}..."
    build_cmake_targets "-DENABLE_UNIT_TESTING=ON" "${UNIT_TARGETS[@]}"
}

build_integration()
{
    echo ">>> Building integration tests for ${BOARD_NAME}..."
    build_cmake_targets "-DENABLE_INTEGRATION_TESTING=ON" "${INTEGRATION_TARGETS[@]}"
}

main()
{
    cd "${repo_dir}"
    ensure_env

    case "${MODE}" in
        unit)
            build_unit
            ;;
        integration)
            build_integration
            ;;
        all)
            build_unit
            stash_unit_artifacts
            build_integration
            restore_unit_artifacts
            ;;
        *)
            echo "Unsupported mode: ${MODE}. Use: unit, integration, all"
            exit 2
            ;;
    esac

    echo ">>> Build (${MODE}) complete for ${BOARD_NAME}."
}

main
