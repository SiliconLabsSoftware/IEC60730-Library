#!/usr/bin/env bash
#
# Install Silicon Labs Tooling (SLT) CLI and packages from recipe.toml.
#

set -euxo pipefail

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

install_slt()
{
    [ -n "${SLT_INSTALL_DIR-}" ] || SLT_INSTALL_DIR="/home/${USER}/.silabs/"
    export SLT_INSTALL_DIR

    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    else
        echo "Unsupported OS: $OSTYPE"
        exit 1
    fi

    local slt_download_url="https://www.silabs.com/documents/public/software/slt-cli-1.1.1-${os_type}-x64.zip"

    if [ ! -d "${SLT_INSTALL_DIR}" ]; then
        mkdir -p "${SLT_INSTALL_DIR}"
    else
        echo "SLT install directory '${SLT_INSTALL_DIR}' already exists. Skipping creation."
    fi
    local slt_zip="${SLT_INSTALL_DIR}/slt.zip"
    wget "${slt_download_url}" -O "${slt_zip}"
    unzip -q -o -j "${slt_zip}" -d "${SLT_INSTALL_DIR}/bin"
    rm -f "${slt_zip}"

    SLT_INSTALL_DIR="${SLT_INSTALL_DIR}/bin"

    # Run SLT for the first time to set up initial configuration
    "${SLT_INSTALL_DIR}/slt" --help > /dev/null 2>&1 || true

    if ! check_slt_installation; then
        echo "SLT installation failed. Exiting."
        exit 1
    fi
}

install_slt_packages()
{
    local recipe_lock="${repo_dir}/recipe.toml"

    if [ ! -f "${recipe_lock}" ]; then
        echo "recipe.toml not found at ${recipe_lock}, cannot install dependencies"
        exit 1
    fi

    echo "Installing SLT dependencies from ${recipe_lock}..."
    cd "${repo_dir}"
    if ! "${SLT_INSTALL_DIR}/slt" install -f "${recipe_lock}"; then
        echo "SLT package installation failed. Exiting."
        exit 1
    fi
}

check_slt_installation()
{
    local slt_location="${HOME}/.silabs/slt/slt.location"
    if [ -f "${slt_location}" ]; then
        SLT_INSTALL_DIR="$(dirname "$(cat "${slt_location}")")"
    fi
    if "${SLT_INSTALL_DIR}/slt" --version >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

slt_upgrade()
{
    if [ -x "${SLT_INSTALL_DIR}/slt" ] || [ -x "/home/${USER}/.silabs/slt" ]; then
        (cd "${SLT_INSTALL_DIR}" && ./slt update --self)
    else
        echo "SLT not found at ${SLT_INSTALL_DIR}/slt. Cannot upgrade."
        return 1
    fi
}

# SLT may write autogen/recipe.slconf; keep a single recipe.slconf at repo root
# (Docker layout) and ensure the IEC60730 extension path is listed.
ensure_recipe_slconf()
{
    local dest="${repo_dir}/recipe.slconf"
    local src_autogen="${repo_dir}/autogen/recipe.slconf"
    local sdk_path
    local tmp

    sdk_path="$("${SLT_INSTALL_DIR}/slt" where simplicity-sdk --ignore-slconf)"

    if [ -f "${src_autogen}" ]; then
        echo "Moving ${src_autogen} -> ${dest}"
        tmp="$(mktemp)"
        # Rewrite sdk-package-path to include this repo as the extension.
        awk -v repo="${repo_dir}" -v sdk="${sdk_path}" '
            BEGIN { in_sdk=0 }
            /^sdk-package-path/ { in_sdk=1; print; next }
            in_sdk && /^\]/ {
                if (sdk != "") print "  \"" sdk "\",    # simplicity-sdk"
                print "  \"" repo "\"    # IEC60730-Library extension"
                print
                in_sdk=0
                next
            }
            in_sdk && /simplicity-sdk|simpl/ { next }
            in_sdk && /IEC60730|workspace/ { next }
            { print }
        ' "${src_autogen}" > "${tmp}"
        mv "${tmp}" "${dest}"
        rm -f "${src_autogen}"
        rmdir "${repo_dir}/autogen" 2>/dev/null || true
    elif [ ! -f "${dest}" ] && [ -n "${sdk_path}" ]; then
        echo "Creating ${dest}"
        cat > "${dest}" <<EOF
# Auto-generated by script/bootstrap_silabs.

[slc]
sdk-package-path = [
  "${sdk_path}",    # simplicity-sdk
  "${repo_dir}"     # IEC60730-Library extension
]
EOF
    fi

    if [ ! -f "${dest}" ]; then
        echo "Failed to create ${dest}"
        return 1
    fi

    # Bootstrap usually runs as root in the container while the repo is a bind
    # mount, so the host user needs to stay able to read the promoted file
    # (mktemp creates it 0600).
    chmod 644 "${dest}"

    # `slt install` generates this wrapper around autogen/recipe.slconf. The
    # promoted root recipe.slconf is canonical, so retaining the wrapper leaves
    # two .slconf files in the repository and breaks SLT's auto-discovery.
    rm -f "${repo_dir}/user.slconf"

    export SLC_SLCONF="${dest}"
}

main_bootstrap_silabs()
{
    [ -n "${SLT_INSTALL_DIR-}" ] || SLT_INSTALL_DIR="/home/${USER}/.silabs/"
    export SLT_INSTALL_DIR

    if ! check_slt_installation; then
        echo "SLT not found. Installing SLT..."
        install_slt
        if ! check_slt_installation; then
            echo "SLT installation failed. Exiting."
            exit 1
        fi
        echo "SLT installed successfully. Installation directory: ${SLT_INSTALL_DIR}"
    else
        echo "SLT already installed. Installation directory: ${SLT_INSTALL_DIR}"
    fi

    slt_upgrade

    install_slt_packages

    ensure_recipe_slconf

    JAVA_HOME="$("${SLT_INSTALL_DIR}/slt" where java21 --ignore-slconf)/jre"
    if [ ! -x "${JAVA_HOME}/bin/java" ]; then
        echo "Java 21 was not found at ${JAVA_HOME}"
        return 1
    fi
    export JAVA_HOME
    export PATH="${JAVA_HOME}/bin:${PATH}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main_bootstrap_silabs
fi
