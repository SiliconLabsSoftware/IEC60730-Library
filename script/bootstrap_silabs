#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(dirname "${script_dir}")"

[ -f "${repo_dir}/sdk.env" ] && source "${repo_dir}/sdk.env"

install_slt()
{
    [ -n "${SLT_INSTALL_DIR-}" ] || SLT_INSTALL_DIR="${HOME}/.silabs"
    export SLT_INSTALL_DIR

    local os_type

    if [[ $OSTYPE == linux* ]]; then
        os_type="linux"
    elif [[ $OSTYPE == darwin* ]]; then
        os_type="mac"
    else
        echo "Unsupported OS: $OSTYPE"
        exit 1
    fi

    local slt_download_url="https://www.silabs.com/documents/public/software/slt-cli-1.1.1-${os_type}-x64.zip"

    mkdir -p "${SLT_INSTALL_DIR}"
    mkdir -p "${SLT_INSTALL_DIR}/bin"

    local slt_zip="${SLT_INSTALL_DIR}/slt.zip"

    wget "${slt_download_url}" -O "${slt_zip}"

    unzip -q -o -j "${slt_zip}" -d "${SLT_INSTALL_DIR}/bin"

    rm -f "${slt_zip}"

    SLT_INSTALL_DIR="${SLT_INSTALL_DIR}/bin"
    export SLT_INSTALL_DIR

    "${SLT_INSTALL_DIR}/slt" --help >/dev/null 2>&1 || true

    if ! check_slt_installation; then
        echo "SLT installation failed."
        exit 1
    fi
}

check_slt_installation()
{
    local search_root="${SLT_INSTALL_DIR:-${HOME}/.silabs}"

    #
    # Explicit / Compose install root (bin/slt or slt in root).
    # Require a regular file: ~/.silabs/slt is often an SLT data directory
    # (installs/engines), and -x alone is true for directories.
    #
    if [ -f "${search_root}/bin/slt" ] && [ -x "${search_root}/bin/slt" ]; then
        SLT_INSTALL_DIR="${search_root}/bin"
        export SLT_INSTALL_DIR
        return 0
    fi

    if [ -f "${search_root}/slt" ] && [ -x "${search_root}/slt" ]; then
        SLT_INSTALL_DIR="${search_root}"
        export SLT_INSTALL_DIR
        return 0
    fi

    #
    # New layout under HOME
    #
    if [ -f "${HOME}/.silabs/bin/slt" ] && [ -x "${HOME}/.silabs/bin/slt" ]; then
        SLT_INSTALL_DIR="${HOME}/.silabs/bin"
        export SLT_INSTALL_DIR
        return 0
    fi

    #
    # Legacy layouts
    #
    local slt_bin

    slt_bin="$(
        find "${HOME}/.silabs" \
            -type f \
            -name slt \
            2>/dev/null \
            | head -n1
    )"

    if [ -n "${slt_bin}" ] && [ -x "${slt_bin}" ]; then
        SLT_INSTALL_DIR="$(dirname "${slt_bin}")"
        export SLT_INSTALL_DIR
        return 0
    fi

    return 1
}

install_slt_packages()
{
    local recipe="${repo_dir}/recipe.toml"

    [ -f "${recipe}" ] || {
        echo "recipe.toml not found: ${recipe}"
        exit 1
    }

    "${SLT_INSTALL_DIR}/slt" install -f "${recipe}"
}

ensure_recipe_slconf()
{

    # Do not overwrite host recipe.slconf from inside Docker.
    if [ -f /.dockerenv ]; then
        return
    fi

    local sdk_path="${SDK_PATH:-}"

    local dest="${repo_dir}/recipe.slconf"

    # local dest

    # if [ -f /.dockerenv ]; then
    #     dest="${repo_dir}/recipe.docker.slconf"
    # else
    #     dest="${repo_dir}/recipe.slconf"
    # fi

    local sdk_path="${SDK_PATH:-}"

    # gecko_4_5 profile: resolve (and download on first use) the Gecko SDK so
    # recipe.slconf points at it instead of the SLT-managed Simplicity SDK.
    if [ -z "${sdk_path}" ] && [ "${SDK_PROFILE:-}" = "gecko_4_5" ]; then
        # shellcheck source=set_gsdk.sh
        source "${script_dir}/set_gsdk.sh" || {
            echo "ERROR: could not resolve Gecko SDK 4.5.0 (set GSDK_PATH or allow the download)."
            exit 1
        }
        sdk_path="${SDK_PATH}"
    fi

    if [ -z "${sdk_path}" ]; then
        sdk_path="$("${SLT_INSTALL_DIR}/slt" where simplicity-sdk --ignore-slconf)"
    fi

    cat > "${dest}" <<EOF
# Auto-generated by bootstrap_silabs.sh

[slc]
sdk-package-path = [
  "${sdk_path}",
  "${repo_dir}"
]
EOF

    chmod 644 "${dest}"

    rm -f \
        "${repo_dir}/user.slconf" \
        "${repo_dir}/autogen/recipe.slconf"

    export SLC_SLCONF="${dest}"
}

main_bootstrap_silabs()
{
    #
    # Ensure SLT is available.
    #
    if ! check_slt_installation; then
        echo
        echo "SLT not found. Installing..."
        echo

        install_slt
    fi

    #
    # Verify installation again.
    #
    if ! check_slt_installation; then
        echo
        echo "ERROR: SLT installation failed."
        echo
        exit 1
    fi

    echo "Using SLT: ${SLT_INSTALL_DIR}/slt"

    install_slt_packages

    ensure_recipe_slconf

    JAVA_HOME="$("${SLT_INSTALL_DIR}/slt" where java21 --ignore-slconf)/jre"

    [ -x "${JAVA_HOME}/bin/java" ] || {
        echo "java21 package not found"
        exit 1
    }

    export JAVA_HOME
    export PATH="${JAVA_HOME}/bin:${PATH}"
}
