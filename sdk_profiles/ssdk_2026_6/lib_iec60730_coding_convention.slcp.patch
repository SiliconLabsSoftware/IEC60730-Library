project_name: lib_iec60730
package: iec60730
quality: test
label: Source code lib IEC60730 for unit test
description: >
  Source code lib IEC60730 for unit test.
category: Example|iec60730

sdk_extension:
  - {id: iec60730, version: 2.0.0, vendor: silabs}
sdk: {id: simplicity_sdk, version: 2026.6.0, vendor: silabs}

component:
  - id: sl_system
  - id: device_init
  - id: clock_manager
  - id: emlib_wdog
  - id: emlib_gpcrc
  - id: uartdrv_core
  - id: emlib_timer
  - id: emlib_letimer
  - id: emlib_rmu
  - id: iostream_usart
    instance: [vcom]
  - id: iostream_retarget_stdio
  - id: udelay
  # Required explicitly when generating for a device without a board BSP.
  - id: board_control
  - id: iec60730_configuration_over_swo_stub
    from: iec60730
  - id: iec60730_custom_linker
    from: iec60730
define:
  - name: SL_TRUSTZONE_SECURE
  - name: SL_IEC60730_BOARD_HEADER
    value: "sl_iec60730_board.h"
config_file:
  - path: ../sample/iec60730_demo/config/xg21/sl_board_control_config.h
    override:
      component: board_control
      file_id: board_control_config
    condition:
      - device_family_efr32bg21
    unless:
      - hardware_board

  - path: ../sample/iec60730_demo/config/xg21/sl_iostream_usart_vcom_config.h
    override:
      component: iostream_usart
      file_id: iostream_usart_config
      instance: vcom
    condition:
      - device_family_efr32bg21
    unless:
      - hardware_board

  - path: ../sample/iec60730_demo/config/xg24/sl_board_control_config.h
    override:
      component: board_control
      file_id: board_control_config
    condition:
      - device_family_efr32bg24
    unless:
      - hardware_board

  - path: ../sample/iec60730_demo/config/xg24/sl_iostream_usart_vcom_config.h
    override:
      component: iostream_usart
      file_id: iostream_usart_config
      instance: vcom
    condition:
      - device_family_efr32bg24
    unless:
      - hardware_board

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 0
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_RX_BUFFER_SIZE
    value: 80
  # CTS/RTS blocks USART_Tx when VCOM/board controller is not driven (COS stub).
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
  - name: SL_IEC60730_IRQ_STATUS_ENABLE
    value: 1
  - name: SL_IEC60730_SAVE_STAGE_ENABLE
    value: 1
  - name: SL_IEC60730_CRC_DEBUG_ENABLE
    value: 0
  # Prefer LFRCO for LF / WDOG (no device_init_lfxo with clock_manager).
  - name: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFRCO
  - name: SL_CLOCK_MANAGER_WDOG0CLK_SOURCE
    value: CMU_WDOG0CLKCTRL_CLKSEL_LFRCO
  - name: SL_CLOCK_MANAGER_WDOG1CLK_SOURCE
    value: CMU_WDOG1CLKCTRL_CLKSEL_LFRCO

toolchain_settings:
  - option: linkerfile
    value: autogen/linkerfile_iec60730.ld
    unless:
      - toolchain_iar
  - option: linkerfile
    value: autogen/linkerfile_iec60730.icf
    condition:
      - toolchain_iar
  - option: iar_linker_option
    value: "--keep check_sum --place_holder check_sum,2,.checksum,64"
    condition:
      - toolchain_iar
template_contribution:
  - name: trustzone_secure
    value: 1
