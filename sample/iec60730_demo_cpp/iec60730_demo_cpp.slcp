# Silicon Labs Project Configuration Tools: slcp, v0

project_name: iec60730_example_demo_cpp
label: IEC60730 Example Demo C++

package: IEC60730
category: IEC60730
quality: production

description: >
  This is a Safety Libraries IEC60730 Example Demo C++.

author: Silicon Laboratories, Inc.

sdk_extension:
  - {id: iec60730, version: 1.1.0}

sdk:
  id: gecko_sdk
  version: 4.5.0

component:
  - from: iec60730
    id: iec60730_lib

  - from: iec60730
    id: iec60730_configuration_over_swo_stub

  - id: sl_system

  - id: device_init

  - id: device_init_hfrco

  - id: uartdrv_core

  - id: iostream_usart
    instance:
      - vcom

  - id: udelay

  # oem_hal_config_board.h includes sl_board_control_config.h, which only
  # exists when board_control is part of the project. A radio board BSP pulls
  # it in implicitly; request it explicitly so device-only targets also get it.
  - id: board_control

# A device-only target (no radio board selected) has no BSP to fill in the
# "sl:start pin_tool" sections of sl_board_control_config.h and
# sl_iostream_usart_vcom_config.h, so those files come out with every pin
# #define commented out. Values placed under "configuration:" cannot fix this,
# because SLC can only substitute defines that are actually present in the file.
# Override the two config files with family-specific pin assignments for
# device-only targets (no radio board selected):
#   xG21: BRD4180A on BRD4002A
#   xG24: BRD4187C A01 derived, QFN40-safe (PA07/PB04 vs PA09/PB05)
# Skipped whenever a board is selected, so board-based targets keep using
# their own BSP configuration.
config_file:
  - path: ./config/xg21/sl_board_control_config.h
    override:
      component: board_control
      file_id: board_control_config
    condition:
      - device_family_efr32bg21
    unless:
      - hardware_board

  - path: ./config/xg21/sl_iostream_usart_vcom_config.h
    override:
      component: iostream_usart
      file_id: iostream_usart_config
      instance: vcom
    condition:
      - device_family_efr32bg21
    unless:
      - hardware_board

  - path: ./config/xg24/sl_board_control_config.h
    override:
      component: board_control
      file_id: board_control_config
    condition:
      - device_family_efr32bg24
    unless:
      - hardware_board

  - path: ./config/xg24/sl_iostream_usart_vcom_config.h
    override:
      component: iostream_usart
      file_id: iostream_usart_config
      instance: vcom
    condition:
      - device_family_efr32bg24
    unless:
      - hardware_board

configuration:

  - name: SL_BOARD_ENABLE_VCOM
    value: 0

  - name: SL_DEVICE_INIT_HFRCO_BAND
    value: cmuHFRCOFreq_19M0Hz
    condition:
      - device_series_1

  - name: SL_IOSTREAM_USART_VCOM_PERIPHERAL
    value: USART0
    condition:
      - device_series_2

  - name: SL_IOSTREAM_USART_VCOM_PERIPHERAL_NO
    value: 0
    condition:
      - device_series_2

define:
  - name: HAL_CONFIG_HEADER
    value: "\"oem_hal_config_board.h\""

include:
  - path: ./
    file_list:
      - path: app.h

  - path: ./pictures/
    file_list:
      - path: test_fail.jpg
      - path: test_pass.jpg

  - path: ./oem/inc/
    file_list:
      - path: oem_hal_config_board.h
      - path: oem_iec60730_timer.h
      - path: oem_iec60730.h
      - path: oem_iec60730_init_device.h
      - path: oem_iec60730_comm.h

source:
  - path: main.cpp
  - path: app.cpp
  - path: ./oem/src/oem_iec60730_init_device.c
  - path: ./oem/src/oem_iec60730.c
  - path: ./oem/src/oem_iec60730_comm.c
  - path: ./oem/src/oem_iec60730_functions.c
  - path: ./oem/src/oem_iec60730_timer.c

toolchain_settings:
  - option: linkerfile
    value: autogen/linkerfile_iec60730.ld
    unless:
      - toolchain_iar

  - option: linkerfile
    value: autogen/linkerfile_iec60730.icf
    condition:
      - toolchain_iar

  - option: iar_linker_option
    value: "--keep check_sum --place_holder check_sum,2,.checksum,64"
    condition:
      - toolchain_iar

template_contribution:
  - name: trustzone_secure
    priority: 0
    value: 1
